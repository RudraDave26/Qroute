# Traffic provider
TRAFFIC_PROVIDER=tomtom
TRAFFIC_API_KEY=

# Optional separate map/search provider keys
TOMTOM_API_KEY=
GEOCODING_PROVIDER=tomtom

# Weather
OPEN_METEO_ENABLED=true

# Optional fuel-price integration
FUEL_PRICE_PROVIDER=manual
FUEL_PRICE_API_KEY=

# Default fuel and electricity prices
DEFAULT_PETROL_PRICE_INR=105
DEFAULT_DIESEL_PRICE_INR=92
DEFAULT_CNG_PRICE_INR=80
DEFAULT_EV_KWH_PRICE_INR=8

# Application
NEXT_PUBLIC_APP_NAME=QuantumRoute AI
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap

# Optional database
DATABASE_URL=

# Optional separate optimization backend
OPTIMIZATION_API_URL=
